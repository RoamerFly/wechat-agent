{
  "version": 1,
  "capabilities": [
    {
      "id": "comfyui.workflows",
      "implementation": "ready",
      "description": "列出当前大肥鱼身份已登记、可用且受批准的 ComfyUI 工作流。不会暴露原始工作流图、节点实现、模型路径或服务地址。",
      "permissions": ["gpu"],
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "output_schema": {"type": "object"},
      "discoverable": true,
      "async": false,
      "side_effect": "none"
    },
    {
      "id": "comfyui.run",
      "implementation": "ready",
      "description": "使用已登记的工作流异步生成图像。工作流标识和输入字段均由宿主核验；不能传入原始工作流、节点、路径、URL 或服务地址。成功仅表示成品已登记，不表示已发送。",
      "permissions": ["artifact.write", "gpu"],
      "input_schema": {
        "type": "object",
        "properties": {
          "workflow_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
          "inputs": {
            "type": "object",
            "maxProperties": 32,
            "additionalProperties": {
              "oneOf": [
                {"type": "string", "maxLength": 4000},
                {"type": "number"},
                {"type": "boolean"}
              ]
            }
          },
          "title": {"type": "string", "maxLength": 120}
        },
        "required": ["workflow_id"],
        "additionalProperties": false
      },
      "output_schema": {"type": "object"},
      "discoverable": true,
      "async": true,
      "side_effect": "artifact"
    },
    {
      "id": "comfyui.job",
      "implementation": "ready",
      "description": "查询或取消当前任务已经创建的 ComfyUI 作业。状态会返回宿主已登记的输出素材；不能借作业号访问其他账号、会话或任务。",
      "permissions": ["artifact.write", "gpu"],
      "input_schema": {
        "type": "object",
        "properties": {
          "job_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "action": {"type": "string", "enum": ["status", "cancel"]}
        },
        "required": ["job_id", "action"],
        "additionalProperties": false
      },
      "output_schema": {"type": "object"},
      "discoverable": true,
      "async": false,
      "side_effect": "write"
    }
  ]
}
