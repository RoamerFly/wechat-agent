-            vec![8],
-            section(
-                &[
-                    vec![1],
-                    section(&[0x12u16.to_be_bytes().to_vec(), now.to_be_bytes().to_vec()].concat()),
-                ]
-                .concat(),
-            ),
-        ]
-        .concat(),
