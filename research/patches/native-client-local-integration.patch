+#![cfg(windows)]
+use wechat_store::Store;
+
+#[test]
+fn offline_profile_copy_preserves_nested_bytes_and_rejects_replacement() {
+    use wechat_store::copy::{copy_profile, inventory};
+    let temp = tempfile::tempdir().unwrap();
+    let source = temp.path().join("source");
+    std::fs::create_dir_all(source.join("nested/empty")).unwrap();
+    std::fs::write(source.join("nested/data.bin"), [0, 255, 7, 1]).unwrap();
+    std::fs::write(source.join("中文.txt"), "synthetic profile").unwrap();
+    let before = inventory(&source).unwrap();
+    let exported = temp.path().join("exported");
+    copy_profile(&source, &exported, true).unwrap();
+    assert_eq!(inventory(&exported).unwrap(), before);
+    let store = Store::open(&temp.path().join("data")).unwrap();
+    let account = store.import("synthetic", &exported, true).unwrap();
+    assert_eq!(inventory(&account.profile_path).unwrap(), before);
+    assert!(store.import("synthetic", &exported, true).is_err());
+    assert!(copy_profile(&source, &exported, true).is_err());
+    assert_eq!(inventory(&source).unwrap(), before);
+    assert_eq!(inventory(&account.profile_path).unwrap(), before);
+}
+
+#[test]
+fn interrupted_managed_bootstrap_restores_only_recorded_empty_reservation() {
+    let temp = tempfile::tempdir().unwrap();
+    let store = Store::open(&temp.path().join("data")).unwrap();
+    let account = store.create_account("synthetic").unwrap();
+    std::fs::remove_dir(&account.profile_path).unwrap();
+    assert!(store.profile_leases().is_err());
+    assert!(!account.profile_path.exists());
+    store.put_runtime("synthetic", "profile-bootstrap", b"initializing").unwrap();
+    let held = store.profile_leases().unwrap();
+    assert!(account.profile_path.is_dir());
+    assert!(std::fs::read_dir(&account.profile_path).unwrap().next().is_none());
+    drop(held);
+    std::fs::write(account.profile_path.join("preserve"), b"synthetic content").unwrap();
+    let held = store.profile_leases().unwrap();
+    assert_eq!(std::fs::read(account.profile_path.join("preserve")).unwrap(), b"synthetic content");
+    drop(held);
+}
+
+#[test]
+fn native_snapshot_retains_recovery_state_and_rebinds_private_paths() {
+    use wechat_store::{copy::inventory, cutover};
+    let temp = wechat_platform::private_tempdir("native-relocation-test-").unwrap();
+    let source = temp.path().join("source");
+    let destination = temp.path().join("destination");
+    let store = Store::open(&source).unwrap();
+    let account = store.create_account("synthetic").unwrap();
+    std::fs::write(
+        account.profile_path.join("profile.bin"),
+        b"synthetic opaque profile",
+    )
+    .unwrap();
+    store
+        .put_runtime(
+            "synthetic",
+            "apply:pending",
+            b"synthetic sealed pending projection",
+        )
+        .unwrap();
+    let key = source.join("accounts/synthetic/keys.json");
+    std::fs::write(&key, b"synthetic key file").unwrap();
+    store.set_keys_file("synthetic", &key).unwrap();
+    let server = store.server_id.clone();
+    drop(store);
+    for name in ["storage-key", "cursor-key"] {
+        use std::io::Write;
+        let mut file = wechat_platform::OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .mode(0o600)
+            .open(source.join(name))
+            .unwrap();
+        file.write_all(b"synthetic vault bytes").unwrap();
+    }
+    let before = inventory(&source).unwrap();
+    cutover::snapshot(&source, &destination, "synthetic").unwrap();
+    assert_eq!(inventory(&source).unwrap(), before);
+    let new_store = Store::open_existing(&destination).unwrap();
+    assert_eq!(new_store.server_id, server);
+    assert_eq!(
+        new_store
+            .runtime("synthetic", "apply:pending")
+            .unwrap()
+            .unwrap(),
+        b"synthetic sealed pending projection"
+    );
+    assert_eq!(
+        new_store.account("synthetic").unwrap().profile_path,
+        std::fs::canonicalize(&destination)
+            .unwrap()
+            .join("accounts/synthetic/profile")
+    );
+    assert_eq!(
+        new_store.keys_file("synthetic").unwrap().unwrap(),
+        std::fs::canonicalize(&destination)
+            .unwrap()
+            .join("accounts/synthetic/keys.json")
+    );
+    assert!(!destination.join("api-token").exists());
+    assert_eq!(
+        std::fs::read(destination.join("storage-key")).unwrap(),
+        b"synthetic vault bytes"
+    );
+    assert!(cutover::snapshot(&source, &destination, "synthetic").is_err());
+    drop(new_store);
+    let control = source.join("accounts/synthetic/agent/control.sqlite");
+    let db = rusqlite::Connection::open(control).unwrap();
+    db.execute("INSERT INTO outbox(id,idempotency_key,payload_hash,destination,payload,state,client_id,created_at) VALUES('queued','key','hash','synthetic',x'00','queued','client','synthetic')", []).unwrap();
+    drop(db);
+    let rejected = temp.path().join("rejected");
+    assert!(cutover::snapshot(&source, &rejected, "synthetic").is_err());
+    assert!(!rejected.exists());
+}
