-impl LonglinkDecoder {
-    fn feed(&mut self, bytes: &[u8]) -> Result<()> {
-        ensure!(
-            self.pending.len().saturating_add(bytes.len()) <= self.max_payload + 65540,
-            "Longlink pending packet limit"
-        );
-        self.pending.extend_from_slice(bytes);
