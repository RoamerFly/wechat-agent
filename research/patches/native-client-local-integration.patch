+
+fn field(node: roxmltree::Node<'_, '_>, name: &str) -> Option<String> {
+    let text = leaf(child(node, name)?)?;
+    let text = text.trim();
+    (!text.is_empty() && text.len() <= 8192 && !text.contains('\0')).then(|| text.to_owned())
+}
+
+fn locator(content: &str) -> Option<Value> {
+    if content.len() > 256 * 1024
+        || content.to_ascii_uppercase().contains("<!DOCTYPE")
+        || content.to_ascii_uppercase().contains("<!ENTITY")
+    {
+        return None;
+    }
+    let doc = roxmltree::Document::parse_with_options(
+        content,
+        roxmltree::ParsingOptions {
+            allow_dtd: false,
+            nodes_limit: 4096,
+            ..Default::default()
+        },
+    )
+    .ok()?;
+    let root = doc.root_element();
+    if root.tag_name().name() != "msg" || root.tag_name().namespace().is_some() {
+        return None;
+    }
+    let app = child(root, "appmsg")?;
+    if field(app, "type")?.parse::<i32>().ok()? != 51 {
+        return None;
+    }
+    let feed = child(app, "finderFeed")?;
+    let media = child(feed, "mediaList").and_then(|list| {
+        list.children().find(|n| {
+            n.is_element() && n.tag_name().name() == "media" && n.tag_name().namespace().is_none()
+        })
+    });
+    let url = media
+        .and_then(|n| field(n, "url"))
+        .filter(|url| wechat_protocol::media::validate_shared_link_url(url).is_ok());
+    let decode_key = media
+        .and_then(|n| field(n, "decodeKey"))
+        .and_then(|s| s.parse::<u64>().ok())
+        .map(|v| v.to_string());
+    let object_id = field(feed, "objectId");
+    if url.is_none() && object_id.is_none() {
+        return None;
+    }
+    Some(
+        json!({"state":if url.is_some(){"available"}else{"unavailable"},
+        "reason":if url.is_some(){""}else{"channels_media_locator_missing"},
+        "mediaUrl":url,"decodeKey":decode_key,"objectId":object_id,
+        "objectNonceId":field(feed,"objectNonceId"),"title":field(feed,"desc"),
+        "author":field(feed,"nickname"),
+        "duration":media.and_then(|n|field(n,"videoPlayDuration").or_else(||field(n,"videoPlayLen")))}),
+    )
+}
+
+impl Core {
+    /// The API holds the account lock; derive the object exclusively from the
+    /// original received card, never a model-supplied object ID.
+    pub fn channels_share_url(&self, account: &str, id: &str) -> Result<Value> {
+        let source = self.channels_media(account, id)?;
+        let reader = self.profile_reader(account)?;
+        let own = self.profile_username(account)?;
+        let message = reader.message(&source_message_id(id)?, own.as_deref())?;
+        anyhow::ensure!(
+            message.outgoing == Some(false),
+            "channels_received_card_required"
+        );
+        let object_id = source["objectId"]
+            .as_str()
+            .and_then(|s| s.parse::<u64>().ok())
+            .filter(|id| *id != 0)
+            .ok_or_else(|| anyhow::anyhow!("channels_object_id_missing"))?;
+        let epoch = self.store.runtime(account, "logout-epoch")?;
+        let native = wechat_protocol::NativeClient::new(Default::default())?;
+        let raw = self.group_read(account, epoch.as_deref(), |state| {
+            native.channels_share_url(state, object_id)
+        })?;
+        let link = wechat_protocol::decode_channels_share(&raw, object_id)?;
+        self.ensure_message_not_recalled(account, id)?;
+        Ok(
+            json!({"accountId":account,"messageId":id,"threadId":source["threadId"],"objectId":object_id.to_string(),"shareUrl":link}),
+        )
+    }
+
+    /// Requires the API's read AND media scopes. Values remain inside the
+    /// authenticated transfer path; ordinary message/quote APIs are unchanged.
+    pub fn channels_media(&self, account: &str, id: &str) -> Result<Value> {
+        self.ensure_message_not_recalled(account, id)?;
+        let reader = self.profile_reader(account)?;
+        let own = self.profile_username(account)?;
+        let msg = reader.message(&source_message_id(id)?, own.as_deref())?;
+        let mut value = json!({"state":"unavailable","reason":"channels_media_locator_missing"});
+        if crate::quotes::message_app(&msg).is_some_and(|a| a.subtype == 51) {
+            if let Some(content) = msg.content.text.as_deref() {
+                let content = msg
+                    .sender
+                    .as_ref()
+                    .and_then(|s| content.strip_prefix(&format!("{s}:\n")))
+                    .unwrap_or(content);
+                if let Some(found) = locator(content) {
+                    value = found;
+                }
+            }
+        }
+        value["messageId"] = json!(id);
+        value["accountId"] = json!(account);
+        value["threadId"] = json!(msg.peer);
+        self.ensure_message_not_recalled(account, id)?;
+        Ok(value)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn retains_private_locator_without_turning_it_into_a_public_card() {
+        let xml = r#"<msg><appmsg><type>51</type><finderFeed><desc>Seaside park</desc><nickname>Travel</nickname><mediaList><media><url><![CDATA[https://finder.video.qq.com/video?token=synthetic]]></url><decodeKey>18446744073709551614</decodeKey><videoPlayDuration>12</videoPlayDuration></media></mediaList></finderFeed></appmsg></msg>"#;
+        let value = locator(xml).unwrap();
+        assert_eq!(value["decodeKey"], "18446744073709551614");
+        assert_eq!(value["title"], "Seaside park");
+        assert_eq!(value["duration"], "12");
+        assert!(crate::quotes::app_message(xml)
+            .unwrap()
+            .link
+            .unwrap()
+            .card
+            .url
+            .is_none());
+    }
+
+    #[test]
+    fn missing_embedded_media_still_retains_received_object_for_native_lookup() {
+        let xml = r#"<msg><appmsg><type>51</type><finderFeed><objectId>18446744073709551614</objectId><desc>Short</desc><nickname>Author</nickname></finderFeed></appmsg></msg>"#;
+        let value = locator(xml).unwrap();
+        assert_eq!(value["objectId"], "18446744073709551614");
+        assert_eq!(value["state"], "unavailable");
+        assert!(value["mediaUrl"].is_null());
+    }
+
+    #[test]
+    fn rejects_other_subtypes_duplicate_fields_and_entities() {
+        assert!(locator("<!DOCTYPE msg><msg/>").is_none());
+        assert!(locator("<msg><appmsg><type>57</type></appmsg></msg>").is_none());
+        assert!(locator("<msg><appmsg><type>51</type><finderFeed><mediaList><media><url>https://example.com/a</url><url>https://example.com/b</url></media></mediaList></finderFeed></appmsg></msg>").is_none());
+    }
+}
