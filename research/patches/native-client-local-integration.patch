-pub fn short_exchange(
-    session: &ShortSession,
-    host: &str,
-    path: &str,
-    payload: &[u8],
-    timeout: Duration,
-) -> Result<Vec<u8>> {
-    validate_host(host)?;
-    ensure!(
-        path.starts_with("/cgi-bin/micromsg-bin/")
-            && path
-                .bytes()
-                .all(|b| b.is_ascii_alphanumeric() || b == b'/' || b == b'-'),
-        "Unsupported native route"
-    );
-    ensure!(
-        payload.len() <= crate::MAX_MESSAGE_BYTES,
-        "Payload too large"
-    );
-    let (hello, extensions) = early_hello(&session.ticket)?;
-    let keys = expand(
-        &session.access_psk,
-        &[b"early data key expansion".as_slice(), &sha256(&hello)].concat(),
-        28,
-    )?;
-    let route = section(
-        &[
-            sized(path.as_bytes())?,
-            sized(host.as_bytes())?,
-            section(payload),
-        ]
-        .concat(),
-    );
-    let wire = [
-        frame(0x19, &hello)?,
-        seal(0x19, &extensions, &keys[..16], &keys[16..], 1)?,
-        seal(0x17, &route, &keys[..16], &keys[16..], 2)?,
-        seal(0x15, &section(&[0, 1, 1]), &keys[..16], &keys[16..], 3)?,
-    ]
-    .concat();
-    let client = reqwest::blocking::Client::builder()
-        .timeout(timeout)
-        .connect_timeout(timeout.min(Duration::from_secs(10)))
-        .redirect(reqwest::redirect::Policy::none())
-        .no_proxy()
-        .build()?;
-    let mut response = client
-        .post(format!(
-            "http://{host}/mmtls/{}",
-            hex::encode(random::<4>()?)
-        ))
-        .header("Content-Type", "application/octet-stream")
-        .header("User-Agent", "MicroMessenger Client")
-        .header("Upgrade", "mmtls")
-        .header("Accept", "*/*")
-        .header("Cache-Control", "no-cache")
-        .header("Connection", "close")
-        .body(wire)
-        .send()?;
-    ensure!(
-        response.status() == 200,
-        "Native shortlink HTTP status {}",
-        response.status().as_u16()
-    );
-    let mut bytes = Vec::new();
-    response
-        .by_ref()
-        .take((crate::MAX_MESSAGE_BYTES + 1) as u64)
-        .read_to_end(&mut bytes)?;
-    ensure!(
-        bytes.len() <= crate::MAX_MESSAGE_BYTES,
