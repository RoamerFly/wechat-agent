+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct Status {
+    state: &'static str,
+    mode: &'static str,
+    pid: u32,
+    server_id: String,
+    account_count: usize,
+    pending_text: u64,
+    pending_media: u64,
+    uncertain_text: u64,
+    uncertain_media: u64,
+}
+
+impl Hold {
+    pub fn open(root: &Path, account: &str) -> Result<Self> {
+        ensure!(valid_account(account), "invalid cutover account");
+        ensure!(
+            root.is_absolute() && is_fixed_drive(root),
+            "cutover requires an absolute path on a fixed Windows drive"
+        );
+        ensure!(
+            !root.components().any(|c| c == Component::ParentDir),
+            "cutover path contains parent traversal"
+        );
+        for path in root.ancestors().filter(|path| path.has_root()) {
+            let metadata = fs::symlink_metadata(path)?;
+            ensure!(
+                metadata.is_dir() && metadata.file_attributes() & 0x400 == 0,
+                "cutover directory is linked or not a directory"
+            );
+        }
+        ensure!(
+            wechat_platform::private_path(root)?,
+            "cutover data directory must be private"
+        );
+        let lock_path = root.join("owner.lock");
+        ensure!(
+            fs::symlink_metadata(&lock_path)?.is_file(),
+            "native owner lock is not a regular file"
+        );
+        // Same OS lease as Store::open. Never create the lock or open a Store:
+        // normal Store/Core startup can migrate control data or resume jobs.
+        let lease = wechat_platform::OpenOptions::new()
+            .read(true)
+            .write(true)
+            .open(&lock_path)?;
+        FileExt::try_lock_exclusive(&lease).context("native data store is already owned")?;
+        let registry = read_database(&root.join("registry.sqlite"))?;
+        let version: u32 = registry.pragma_query_value(None, "user_version", |r| r.get(0))?;
+        ensure!(
+            (1..=2).contains(&version),
+            "unsupported cutover registry schema"
+        );
+        let server_id: String = registry.query_row(
+            "SELECT value FROM metadata WHERE key='server_id'",
+            [],
+            |r| r.get(0),
+        )?;
+        ensure!(
+            uuid::Uuid::parse_str(&server_id).is_ok(),
+            "invalid cutover native dataset"
+        );
+        let mut query = registry.prepare("SELECT id FROM accounts LIMIT 4097")?;
+        let accounts = query
+            .query_map([], |r| r.get::<_, String>(0))?
+            .collect::<rusqlite::Result<Vec<_>>>()?;
+        ensure!(
+            accounts.len() <= 4096 && accounts.iter().any(|id| id == account),
+            "cutover account is not registered or inventory exceeds limit"
+        );
+        let mut status = Status {
+            state: "ready",
+            mode: "cutover_hold",
+            pid: std::process::id(),
+            server_id,
+            account_count: accounts.len(),
+            pending_text: 0,
+            pending_media: 0,
+            uncertain_text: 0,
+            uncertain_media: 0,
+        };
+        let accounts_dir = root.join("accounts");
+        check_private_dir(&accounts_dir)?;
+        for id in accounts {
+            ensure!(valid_account(&id), "invalid account in cutover registry");
+            let account_dir = accounts_dir.join(id);
+            let agent = account_dir.join("agent");
+            check_private_dir(&account_dir)?;
+            check_private_dir(&agent)?;
+            let control = read_database(&agent.join("control.sqlite"))?;
+            let version: u32 = control.pragma_query_value(None, "user_version", |r| r.get(0))?;
+            ensure!(
+                (1..=7).contains(&version),
+                "unsupported cutover account schema"
+            );
+            let (pending, uncertain) = queue_counts(&control, "outbox", version >= 2,
+                "SELECT count(CASE WHEN state='queued' THEN 1 END), count(CASE WHEN state NOT IN ('queued','accepted','failed','rejected','cancelled') THEN 1 END) FROM outbox",
+            )?;
+            status.pending_text += pending;
+            status.uncertain_text += uncertain;
+            let (pending, uncertain) = queue_counts(&control, "media_jobs", version >= 3,
+                "SELECT count(CASE WHEN state IN ('queued','running') THEN 1 END), count(CASE WHEN kind='send' AND state NOT IN ('queued','running','accepted','failed','rejected','cancelled') THEN 1 END) FROM media_jobs",
+            )?;
+            status.pending_media += pending;
+            status.uncertain_media += uncertain;
+        }
+        Ok(Self {
+            status,
+            _lease: lease,
+        })
+    }
+}
+
+fn queue_counts(db: &Connection, table: &str, expected: bool, sql: &str) -> Result<(u64, u64)> {
+    let present: bool = db.query_row(
+        "SELECT EXISTS(SELECT 1 FROM sqlite_schema WHERE type='table' AND name=?1)",
+        [table],
+        |r| r.get(0),
+    )?;
+    ensure!(
+        present == expected,
+        "cutover queue tables do not match the account schema"
+    );
+    if !present {
+        return Ok((0, 0));
+    }
+    Ok(db.query_row(sql, [], |r| Ok((r.get(0)?, r.get(1)?)))?)
+}
+
+fn is_fixed_drive(path: &Path) -> bool {
+    #[link(name = "kernel32")]
+    extern "system" {
+        fn GetDriveTypeW(root: *const u16) -> u32;
+    }
+    let drive = match path.components().next() {
+        Some(Component::Prefix(prefix)) => match prefix.kind() {
+            Prefix::Disk(drive) | Prefix::VerbatimDisk(drive) => drive,
+            _ => return false,
+        },
+        _ => return false,
+    };
+    let root = [u16::from(drive), u16::from(b':'), u16::from(b'\\'), 0];
+    // A mapped drive letter can still refer to a remote store.
+    unsafe { GetDriveTypeW(root.as_ptr()) == 3 } // DRIVE_FIXED
+}
+
+fn check_private_dir(path: &Path) -> Result<()> {
+    ensure!(
+        fs::symlink_metadata(path)?.is_dir() && wechat_platform::private_path(path)?,
+        "cutover control directory is unavailable or linked"
+    );
+    Ok(())
+}
+
+fn valid_account(value: &str) -> bool {
+    !value.is_empty()
+        && value.len() <= 64
+        && value
+            .bytes()
+            .all(|b| b.is_ascii_alphanumeric() || b == b'_' || b == b'-')
+}
+
+fn read_database(path: &Path) -> Result<Connection> {
+    ensure!(
+        fs::symlink_metadata(path)?.is_file() && wechat_platform::private_path(path)?,
+        "cutover database must be a private regular file"
+    );
+    for suffix in ["-wal", "-shm", "-journal"] {
+        let mut sidecar = path.as_os_str().to_os_string();
+        sidecar.push(suffix);
+        match fs::symlink_metadata(sidecar) {
+            Err(error) if error.kind() == ErrorKind::NotFound => {}
+            Err(error) => return Err(error.into()),
+            Ok(_) => anyhow::bail!("cutover database has an unverified journal or WAL sidecar"),
+        }
+    }
+    // The owner lock excludes the native writer and we rejected outstanding
+    // journals. Immutable mode avoids creating SQLite shared-memory files.
+    let raw = path
+        .to_str()
+        .context("cutover database path is not UTF-8")?;
+    let local = raw.strip_prefix(r"\\?\").unwrap_or(raw).replace('\\', "/");
+    let mut uri = String::from("file:///");
+    for b in local.bytes() {
+        if b.is_ascii_alphanumeric() || b"/-_.~:".contains(&b) {
+            uri.push(char::from(b));
+        } else {
+            write!(uri, "%{b:02X}")?;
+        }
+    }
+    uri.push_str("?immutable=1");
+    Ok(Connection::open_with_flags(
+        uri,
+        OpenFlags::SQLITE_OPEN_READ_ONLY
+            | OpenFlags::SQLITE_OPEN_URI
+            | OpenFlags::SQLITE_OPEN_NOFOLLOW,
+    )?)
+}
+
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct Snapshot {
+    state: &'static str,
+    server_id: String,
+    account_count: usize,
+    native_state_preserved: bool,
+    profile_projection: &'static str,
+}
+
+/// Relocate a stopped native store together with its encrypted recovery state.
+/// Unlike an official profile export, this retains pending projections and the
+/// original dataset. It admits no daemon and performs no protocol operation.
+pub fn snapshot(root: &Path, destination: &Path, account: &str) -> Result<Snapshot> {
+    let hold = Hold::open(root, account)?;
+    ensure!(
+        hold.status.pending_text == 0
+            && hold.status.pending_media == 0
+            && hold.status.uncertain_text == 0
+            && hold.status.uncertain_media == 0,
+        "native deliveries must be settled before relocation"
+    );
+    ensure!(
+        destination.is_absolute() && is_fixed_drive(destination),
+        "native destination must be on a fixed Windows drive"
+    );
+    for path in destination
+        .parent()
+        .context("destination needs a parent")?
+        .ancestors()
+        .filter(|p| p.has_root())
+    {
+        let metadata = fs::symlink_metadata(path)?;
+        ensure!(
+            metadata.is_dir() && metadata.file_attributes() & 0x400 == 0,
+            "native destination parent is linked or unavailable"
+        );
+    }
+    let root = fs::canonicalize(root)?;
+    let parent = fs::canonicalize(destination.parent().context("destination needs a parent")?)?;
+    check_private_dir(&parent)?;
+    let destination = parent.join(
+        destination
+            .file_name()
+            .context("destination needs a name")?,
+    );
+    ensure!(
+        !destination.starts_with(&root) && !root.starts_with(&destination),
+        "native source and destination overlap"
+    );
+    ensure!(
+        fs::symlink_metadata(&destination).is_err_and(|e| e.kind() == ErrorKind::NotFound),
+        "native destination already exists or is unavailable"
+    );
+    let registry = read_database(&root.join("registry.sqlite"))?;
+    let accounts = registry
+        .prepare("SELECT id,storage_mode,profile_path FROM accounts")?
+        .query_map([], |r| {
+            Ok((
+                r.get::<_, String>(0)?,
+                r.get::<_, String>(1)?,
+                r.get::<_, String>(2)?,
+            ))
+        })?
+        .collect::<rusqlite::Result<Vec<_>>>()?;
+    let keys = registry
+        .prepare("SELECT account_id,keys_file FROM account_settings WHERE keys_file IS NOT NULL")?
+        .query_map([], |r| Ok((r.get::<_, String>(0)?, r.get::<_, String>(1)?)))?
+        .collect::<rusqlite::Result<Vec<_>>>()?;
+    drop(registry);
+    for (id, mode, profile) in &accounts {
+        ensure!(
+            mode == "managed"
+                && fs::canonicalize(profile)? == root.join("accounts").join(id).join("profile"),
+            "relocation requires profiles inside their managed account directory"
+        );
+    }
+    let account_root = root.join("accounts");
+    let before = crate::copy::inventory(&account_root)?;
+    for entry in &before.entries {
+        ensure!(
+            entry.kind != "symlink",
+            "native snapshot cannot contain links"
+        );
+        if entry.kind == "file" {
+            let name = entry
+                .path
+                .file_name()
+                .and_then(|n| n.to_str())
+                .context("invalid native filename")?;
+            ensure!(
+                !name.ends_with("-wal") && !name.ends_with("-shm") && !name.ends_with("-journal"),
+                "native snapshot contains an outstanding SQLite journal"
+            );
+            if name.ends_with(".sqlite") {
+                let db = read_database(&account_root.join(&entry.path))?;
+                let check: String = db.query_row("PRAGMA quick_check", [], |r| r.get(0))?;
+                ensure!(check == "ok", "native database integrity check failed");
+            }
+        }
+    }
+    let key_paths = keys
+        .iter()
+        .map(|(id, path)| {
+            let path = fs::canonicalize(path)?;
+            ensure!(
+                path.starts_with(account_root.join(id)),
+                "native key file is outside its account"
+            );
+            ensure!(
+                fs::symlink_metadata(&path)?.is_file(),
+                "native key file is not regular"
+            );
+            Ok((id, path.strip_prefix(&root)?.to_owned()))
+        })
+        .collect::<Result<Vec<_>>>()?;
+    let stage = wechat_platform::private_tempdir_in(&parent, ".native-relocate-")?;
+    let mut root_bytes = Vec::new();
+    for name in ["registry.sqlite", "storage-key", "cursor-key"] {
+        let path = root.join(name);
+        let file = wechat_platform::OpenOptions::new()
+            .read(true)
+            .custom_flags(wechat_platform::NOFOLLOW)
+            .open(&path)?;
+        ensure!(
+            file.metadata()?.is_file() && wechat_platform::private_file(&file)?,
+            "native root file must be private and regular"
+        );
+        let bytes = fs::read(&path)?;
+        let mut output = wechat_platform::OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .mode(0o600)
+            .open(stage.path().join(name))?;
+        std::io::Write::write_all(&mut output, &bytes)?;
+        output.sync_all()?;
+        root_bytes.push((path, bytes));
+    }
+    crate::copy::copy_profile(&account_root, &stage.path().join("accounts"), true)?;
+    let mut db = Connection::open(stage.path().join("registry.sqlite"))?;
+    let tx = db.transaction()?;
+    for (id, _, _) in &accounts {
+        let path = destination.join("accounts").join(id).join("profile");
+        tx.execute(
+            "UPDATE accounts SET profile_path=?1 WHERE id=?2",
+            rusqlite::params![path.to_str().context("invalid native profile path")?, id],
+        )?;
+    }
+    for (id, relative) in key_paths {
+        let path = destination.join(relative);
+        tx.execute(
+            "UPDATE account_settings SET keys_file=?1 WHERE account_id=?2",
+            rusqlite::params![path.to_str().context("invalid native key path")?, id],
+        )?;
+    }
+    tx.commit()?;
+    let check: String = db.query_row("PRAGMA quick_check", [], |r| r.get(0))?;
+    ensure!(check == "ok", "relocated registry integrity check failed");
+    drop(db);
+    fs::OpenOptions::new()
+        .write(true)
+        .open(stage.path().join("registry.sqlite"))?
+        .sync_all()?;
+    ensure!(
+        crate::copy::inventory(&account_root)? == before,
+        "native source changed during relocation"
+    );
+    for (path, bytes) in root_bytes {
+        ensure!(
+            fs::read(path)? == bytes,
+            "native root state changed during relocation"
+        );
+    }
+    crate::copy::publish(stage.path(), &destination)?;
+    Ok(Snapshot {
+        state: "copied",
+        server_id: hold.status.server_id.clone(),
+        account_count: accounts.len(),
+        native_state_preserved: true,
+        profile_projection: "preserved_without_repair",
+    })
+}
