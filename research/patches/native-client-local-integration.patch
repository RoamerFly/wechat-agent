+    /// Create one explicit continuation for a cancelled multi-part voice job.
+    /// The idempotency key and the parent-to-continuation uniqueness check live
+    /// in the same transaction so concurrent resume requests cannot create two
+    /// queues. This intentionally does not inspect the encrypted plan; Core
+    /// has already validated per-part receipts before calling it.
+    #[allow(clippy::too_many_arguments)]
+    pub fn create_resumed_voice_job(
+        &self,
+        account: &str,
+        parent_id: &str,
+        id: &str,
+        key: &str,
+        hash: &str,
+        data: &Value,
+        payload: &[u8],
+    ) -> Result<(MediaJobRecord, bool)> {
+        self.control(account, |db| {
+            if key.is_empty() || key.len() > 250 || id.is_empty() || id.len() > 100 || hash.len() != 64 {
+                bail!("invalid media job");
+            }
+            let tx = db.transaction()?;
+            let key = key.strip_prefix("send:").ok_or_else(|| anyhow::anyhow!("invalid media idempotency namespace"))?;
+            let text_exists: bool = tx.query_row(
+                "SELECT EXISTS(SELECT 1 FROM outbox WHERE idempotency_key=?1)",
+                [key], |r| r.get(0),
+            )?;
+            if text_exists { bail!("idempotency_conflict"); }
+            let existing: Option<(String, String, String)> = tx.query_row(
+                "SELECT id,request_hash,data_json FROM media_jobs WHERE idempotency_key=?1",
+                [format!("send:{key}")], |r| Ok((r.get(0)?, r.get(1)?, r.get(2)?)),
+            ).optional()?;
+            if let Some((existing_id, existing_hash, existing_data)) = existing {
+                let existing_data: Value = serde_json::from_str(&existing_data)?;
+                if existing_hash != hash || existing_data["resumedFrom"].as_str() != Some(parent_id) {
+                    bail!("idempotency_conflict");
+                }
+                return Ok((read_job(&tx, &existing_id)?, false));
+            }
+            let prior: Option<String> = tx.query_row(
+                "SELECT id FROM media_jobs WHERE kind='send' AND json_extract(data_json,'$.resumedFrom')=?1 LIMIT 1",
+                [parent_id], |r| r.get(0),
+            ).optional()?;
+            if prior.is_some() { bail!("media_cancelled_resume_already_created"); }
+            let queued: u32 = tx.query_row(
+                "SELECT count(*) FROM media_jobs WHERE state IN ('queued','running')", [], |r| r.get(0),
+            )?;
+            if queued >= 100 { bail!("media_queue_full"); }
+            let now = chrono::Utc::now().to_rfc3339();
+            tx.execute(
+                "INSERT INTO media_jobs VALUES(?1,?2,?3,'send','queued','queued',0,0,0,NULL,?4,?5,?6,?6)",
+                params![id, format!("send:{key}"), hash, serde_json::to_string(data)?, payload, now],
+            )?;
+            let row = read_job(&tx, id)?;
+            job_event(&tx, account, &row)?;
+            tx.commit()?;
+            Ok((row, true))
+        })
+    }
