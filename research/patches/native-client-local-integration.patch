-        28,
-    )?;
-    let finish = signed_payload(&open(&records[1], &keys[..16], &keys[16..], 1)?, 0x14)?;
-    let expected = hmac(
-        &expand(&session.access_psk, b"server finished", 32)?,
-        &sha256(&transcript),
-    )?;
