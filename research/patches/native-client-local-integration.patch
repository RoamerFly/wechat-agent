+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn mentions_use_exact_direct_source_ids() {
+        assert_eq!(
+            mentions(
+                Some("<msgsource><atuserlist><![CDATA[self,other]]></atuserlist></msgsource>"),
+                Some("self")
+            )["self"],
+            true
+        );
+        assert_eq!(
+            mentions(
+                Some("<msgsource><atuserlist>self-more</atuserlist></msgsource>"),
+                Some("self")
+            )["self"],
+            false
+        );
+        assert_eq!(
+            mentions(
+                Some("<msgsource><quote><atuserlist>self</atuserlist></quote></msgsource>"),
+                Some("self")
+            )["self"],
+            false
+        );
+        assert_eq!(mentions(Some("@self"), Some("self"))["state"], "unknown");
+        assert_eq!(
+            mentions(Some("<!DOCTYPE x><msgsource/>"), Some("self"))["state"],
+            "unknown"
+        );
+        assert!(mentions(Some("<msgsource/>"), Some("self"))["all"].is_null());
+    }
+    #[test]
+    fn files_project_safe_metadata_without_cdn_credentials() {
+        let xml="<msg><appmsg><type>6</type><title>notes.txt</title><appattach><totallen>42</totallen><cdnattachurl>PRIVATE_CDN_SENTINEL</cdnattachurl><aeskey>PRIVATE_KEY_SENTINEL</aeskey></appattach></appmsg></msg>";
+        let msg=wechat_profile::Message{
+            id:SourceMessageId{database:"message/message_0.db".into(),table:"Msg_synthetic".into(),local_id:"1".into()},
+            server_message_id:Some("7".into()),server_id_signed:None,peer:Some("room@chatroom".into()),sender:Some("member".into()),outgoing:Some(false),message_type:49,local_type:((6_u64<<32)|49).to_string(),create_time:100,sort_seq:None,
+            content:wechat_profile::DecodedField{text:Some(xml.into()),state:wechat_profile::DecodeState::Utf8,compression_flag:None},
+            source:wechat_profile::DecodedField{text:None,state:wechat_profile::DecodeState::Null,compression_flag:None},raw_fields:Default::default()
+        };
+        let value=normalized_message("one",msg.clone(),None,"v").unwrap();
+        assert_eq!(value["media"][0]["filename"],"notes.txt");assert_eq!(value["media"][0]["bytes"],42);
+        assert!(!value.to_string().contains("PRIVATE_"));
+        let mut unknown=msg;unknown.local_type=((74_u64<<32)|49).to_string();
+        assert!(normalized_message("one",unknown,None,"v").unwrap()["media"].as_array().unwrap().is_empty());
+    }
+    #[test]
+    fn message_ids_preserve_full_scoped_decimal_values() {
+        let id = SourceMessageId {
+            database: "message/message_0.db".into(),
+            table: "Msg_synthetic".into(),
+            local_id: "18446744073709551615".into(),
+        };
+        assert_eq!(source_message_id(&message_id(&id).unwrap()).unwrap(), id);
+    }
+}
