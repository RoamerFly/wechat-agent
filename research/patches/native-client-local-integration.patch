+#[cfg(windows)]
+fn cutover_hold(cli: &Cli) -> Result<()> {
+    use std::io::{Read, Write};
+    anyhow::ensure!(
+        cli.server_config.is_none() && cli.token_file.is_none() && cli.listen.is_none()
+            && cli.client_config.is_none() && cli.url.is_none() && cli.server_name.is_none()
+            && cli.local_profile.is_none(),
+        "cutover hold accepts only explicit data-dir and account"
+    );
+    let hold = wechat_store::cutover::Hold::open(
+        cli.data_dir.as_deref().context("cutover data-dir is required")?,
+        cli.account.as_deref().context("cutover account is required")?,
+    )?;
+    let mut stdout = std::io::stdout().lock();
+    serde_json::to_writer(&mut stdout, &hold.status)?;
+    writeln!(stdout)?;
+    stdout.flush()?;
+    let mut command = [0u8; 5];
+    let mut input = std::io::stdin().lock();
+    input.read_exact(&mut command).context("cutover stop pipe closed without acknowledgment")?;
+    if &command == b"stop\r" {
+        input.read_exact(&mut command[..1])?;
+        anyhow::ensure!(command[0] == b'\n', "invalid cutover stop command");
+    } else {
+        anyhow::ensure!(&command == b"stop\n", "invalid cutover stop command");
+    }
+    drop(hold);
+    Ok(())
+}
