@@ -0,0 +1,123 @@
+//! Read-only Finder H5 URL lookup. Contract recovered from Linux 4.1.13.26;
+//! no browser, certificate, proxy or desktop process is involved.
+use super::*;
+
+pub fn channels_share_request(state: &AccountState, object_id: u64) -> Result<Vec<u8>> {
+    ensure!(object_id != 0, "channels_object_id_invalid");
+    state.validate()?;
+    let base = p::message(&[
+        p::bytes(1, &state.session_key),
+        p::uint(2, state.uin as u64),
+        p::bytes(3, &state.device.device_id),
+        p::int32(4, state.device.client_version),
+        p::bytes(5, state.device.device_type.as_bytes()),
+        p::uint(6, 0),
+    ])?;
+    p::message(&[p::bytes(1, &base), p::bytes(2, &[]), p::uint(3, object_id)])
+}
+
+pub fn decode_channels_share(raw: &[u8], object_id: u64) -> Result<String> {
+    ensure!(
+        object_id != 0 && raw.len() <= 65536,
+        "channels_share_response_invalid"
+    );
+    let fields = p::decode(raw)?;
+    ensure!(
+        p::base_code(&fields)? == 0,
+        "channels_share_lookup_rejected"
+    );
+    let items: Vec<_> = fields.iter().filter(|f| f.number == 3).collect();
+    ensure!(items.len() == 1, "channels_share_identity_missing");
+    let p::Value::Bytes(item) = &items[0].value else {
+        bail!("channels_share_response_invalid")
+    };
+    let item = p::decode(item)?;
+    ensure!(
+        p::scalar(&item, 1)? == object_id,
+        "channels_share_identity_mismatch"
+    );
+    let link = std::str::from_utf8(p::data(&item, 2)?)?;
+    if let Some(top) = p::optional_data(&fields, 2)? {
+        ensure!(top == link.as_bytes(), "channels_share_identity_mismatch");
+    }
+    let tail = link
+        .strip_prefix("https://weixin.qq.com/sph/")
+        .ok_or_else(|| anyhow::anyhow!("channels_share_link_invalid"))?;
+    ensure!(
+        (6..=128).contains(&tail.len())
+            && tail
+                .bytes()
+                .all(|b| b.is_ascii_alphanumeric() || b == b'_' || b == b'-'),
+        "channels_share_link_invalid"
+    );
+    Ok(link.to_owned())
+}
+
+impl NativeClient {
+    pub fn channels_share_url(&self, state: &mut AccountState, id: u64) -> Result<Vec<u8>> {
+        let request = channels_share_request(state, id)?;
+        let raw = self.authenticated_rpc(
+            state,
+            22069,
+            "/cgi-bin/micromsg-bin/findergetfeedh5url",
+            &request,
+        )?;
+        decode_channels_share(&raw, id)?;
+        Ok(raw)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn response(id: u64, url: &str) -> Vec<u8> {
+        p::message(&[
+            p::bytes(1, &p::uint(1, 0)),
+            p::bytes(2, url.as_bytes()),
+            p::bytes(
+                3,
+                &p::message(&[p::uint(1, id), p::bytes(2, url.as_bytes())]).unwrap(),
+            ),
+        ])
+        .unwrap()
+    }
+    #[test]
+    fn channels_share_requires_exact_full_width_identity_and_public_sph() {
+        let id = u64::MAX - 1;
+        let link = "https://weixin.qq.com/sph/Synthetic12";
+        assert_eq!(
+            decode_channels_share(&response(id, link), id).unwrap(),
+            link
+        );
+        assert!(decode_channels_share(&response(id, link), id - 1).is_err());
+        for bad in [
+            "http://weixin.qq.com/sph/Synthetic12",
+            "https://weixin.qq.com.evil.test/sph/Synthetic12",
+            "https://weixin.qq.com/sph/Synthetic12?token=x",
+            "https://weixin.qq.com/sph/../private",
+        ] {
+            assert!(decode_channels_share(&response(id, bad), id).is_err());
+        }
+    }
+    #[test]
+    fn channels_share_rejects_business_errors_duplicates_and_unbound_links() {
+        let link = "https://weixin.qq.com/sph/Synthetic12";
+        let mut raw = response(99, link);
+        raw.extend(p::bytes(
+            3,
+            &p::message(&[p::uint(1, 99), p::bytes(2, link.as_bytes())]).unwrap(),
+        ));
+        assert!(decode_channels_share(&raw, 99).is_err());
+        assert!(decode_channels_share(
+            &p::message(&[p::bytes(1, &p::int32(1, -2)), p::bytes(2, link.as_bytes())]).unwrap(),
+            99
+        )
+        .is_err());
+        assert!(decode_channels_share(
+            &p::message(&[p::bytes(1, &p::uint(1, 0)), p::bytes(2, link.as_bytes())]).unwrap(),
+            99
+        )
+        .is_err());
+        assert!(decode_channels_share(&vec![0; 65537], 99).is_err());
+    }
+}
