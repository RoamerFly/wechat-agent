{
  "version": 1,
  "capabilities": [
    {
      "id": "observation.title",
      "implementation": "ready",
      "description": "获取公开稿件的标题",
      "permissions": [
        "network"
      ],
      "discoverable": true
    },
    {
      "id": "observation.body",
      "implementation": "ready",
      "description": "获取投稿者填写的稿件简介",
      "permissions": [
        "network"
      ],
      "discoverable": true
    },
    {
      "id": "observation.page-text",
      "implementation": "ready",
      "description": "在独立无头 Edge 中读取获准 BV 页面上的标题和简介",
      "permissions": [
        "network"
      ],
      "discoverable": true,
      "requires_owner_setting": "browser_enabled"
    },
    {
      "id": "observation.playback",
      "implementation": "ready",
      "description": "在独立 Edge 中对公开单段媒体静音采样并返回实际播放区间",
      "permissions": [
        "network"
      ],
      "discoverable": true,
      "requires_owner_setting": "playback_enabled"
    },
    {
      "id": "observation.comments",
      "implementation": "ready",
      "description": "分页读取获准 BV 的公开一级评论文字及来源",
      "permissions": [
        "network"
      ],
      "discoverable": true,
      "requires_owner_setting": "comments_enabled"
    },
    {
      "id": "observation.audio",
      "implementation": "ready",
      "description": "分段解码获准公开单段视频并委托本机语音识别",
      "permissions": [
        "network"
      ],
      "discoverable": true,
      "requires_owner_setting": "audio_enabled"
    },
    {
      "id": "publication.video",
      "implementation": "ready",
      "description": "独立发布授权下上传单个 MP4，按原任务编号继续分片并查询稿件状态",
      "permissions": [
        "network"
      ],
      "discoverable": true,
      "requires_owner_setting": "publication-settings.json"
    },
    {
      "id": "publication.reconciliation",
      "implementation": "ready",
      "description": "本机主人查询授权账号的稿件候选与指定 BV 状态，结果作为独立观察保留",
      "permissions": ["network"],
      "discoverable": false,
      "requires_owner_setting": "publication-settings.json"
    },
    {
      "id": "authorization.verify",
      "implementation": "ready",
      "description": "本机主人登记凭据时核验开放平台应用范围内的账号身份",
      "permissions": ["network"],
      "discoverable": false,
      "requires_owner_setting": "publication-settings.json"
    },
    {
      "id": "authorization.oauth",
      "implementation": "ready",
      "description": "本机主人发起的网页授权码兑换及刷新令牌单次轮换",
      "permissions": ["network"],
      "discoverable": false
    }
  ]
}
