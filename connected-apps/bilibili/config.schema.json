{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "revision",
    "enabled",
    "videos"
  ],
  "properties": {
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "enabled": {
      "type": "boolean",
      "default": false
    },
    "browser_enabled": {
      "type": "boolean",
      "default": false
    },
    "playback_enabled": {
      "type": "boolean",
      "default": false
    },
    "videos": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 100,
      "items": {
        "type": "string",
        "pattern": "^BV[0-9A-Za-z]{10}$"
      }
    },
    "comments_enabled": {
      "type": "boolean",
      "default": false
    },
    "audio_enabled": {
      "type": "boolean",
      "default": false
    }
  }
}
